\ExplSyntaxOn

\ProvidesPackage{pf2e}

% Load Required Packages
\input {lib/pf2e-requi.def}

% Set page geometry
\geometry{
    top         = 0cm,
    bottom      = 0cm,
    left        = -0.6cm,
    right       = 0cm,
    footskip    = 8mm, % Bottom of text area to bottom of footer text
    columnsep   = 8mm, % Space between columns
}

% Set paragraph and line spacing
\setlength {\parindent} {1em}
\linespread {0.8}

% Set column and row seperators
% for tblr (provided by tabularray package)
\SetTblrInner{rowsep=1.67pt, colsep=3pt}
% for normal tabular
\setlength{\tabcolsep}{3pt}

% Restrict hyphenation
\tolerance        = 1
\emergencystretch = \maxdimen
\hyphenpenalty    = 10000
\hbadness         = 10000

%\RaggedRight

% Set Font
\setmainfont[
    Path=lib/fonts/Kalam/,
    Ligatures=TeX,
    UprightFont = *-Regular,
    BoldFont = *-Bold
]{Kalam}

\newcommand{\TEMLsize}{\fontsize{13.3pt}{15.6pt}\selectfont}

% PSTricks settings
\psset{xunit=1pt,yunit=1pt,runit=1pt}

% Customize itemize environment.
\setlist{leftmargin=1em}
\setitemize{noitemsep,topsep=0.5ex,label=\footnotesize{$\bullet$}}

\newcommand{\bgcolbw}{img/backgrounds_col.pdf}
\newcommand{\printerfriendly}[1]{\ifstrequal{#1}{true}{
    \renewcommand{\bgcolbw}{img/backgrounds_bw.pdf}}{
    \renewcommand{\bgcolbw}{img/backgrounds_col.pdf}}
}

