% % % TEML PARSING % % %
\newcommand{\TEMLswitch}[2]{
    \ifstrequal{#1}{T}{\renewcommand{#2}{2}}{}
    \ifstrequal{#1}{E}{\renewcommand{#2}{4}}{}
    \ifstrequal{#1}{M}{\renewcommand{#2}{6}}{}
    \ifstrequal{#1}{L}{\renewcommand{#2}{8}}{}
    \ifstrempty{#1}{\renewcommand{#2}{0}}{}
}

\newcommand{\TEMLdisplay}[1]{
    \ifnumcomp{#1}{>}{7}{XXXX}{
    \ifnumcomp{#1}{>}{5}{XXX}{
    \ifnumcomp{#1}{>}{3}{XX}{
    \ifnumcomp{#1}{>}{1}{X}{
    }}}}
}

% % % BPS PARSING % % %
\newcommand{\BPSshift}[2]{
    \ifstrequal{#1}{B}{\renewcommand{#2}{17}}{}
    \ifstrequal{#1}{P}{\renewcommand{#2}{9}}{}
    \ifstrequal{#1}{S}{\renewcommand{#2}{1}}{}
    \ifstrempty{#1}{\renewcommand{#2}{0}}{}
}

% % % RANGED WEAPON SPECIAL PARSING % % %
\newcommand{\RspecialParse}[2]{
    \ifstrequal{#1}{fullStr}{\renewcommand{#2}{+\STRmod}}{
    \ifstrequal{#1}{halfStr}{\renewcommand{#2}{+\fpeval{floor(\STRmod/2)}}}{
    \ifstrempty{#1}{\renewcommand{#2}{+0}}{\renewcommand{#2}{+#1}}}}
}